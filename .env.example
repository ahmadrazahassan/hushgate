# Public site URL (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=https://hushgate.uk

# Chrome Web Store listing. Leave empty until the extension is published.
NEXT_PUBLIC_CHROME_STORE_URL=

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: Hushgate control plane admin API (live sessions, locations and VPN sign-outs in the admin panel)
GATEWAY_API_URL=https://155-138-149-113.sslip.io
# Same value as /etc/merlon-gateway/admin-key on the control plane. Server only.
GATEWAY_ADMIN_KEY=
